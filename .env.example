# Copy to .env.local (ignored by git) and fill in. Vercel: set the same keys in the project settings.

# Supabase project URL (Project Settings → API). Public: shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key. Public: row access is enforced by RLS (is_app_user), not by this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service-role key. Server only: bypasses RLS for the client portal and the reminder cron.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer token Vercel Cron sends to /api/cron/reminders (see vercel.json). The route refuses to run without it.
CRON_SECRET=
# Google Cloud OAuth client used for Gmail send and Drive upload.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the deployed app, no trailing slash. Register ${NEXT_PUBLIC_APP_URL}/api/gmail/callback as the OAuth redirect URI.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# NODE_ENV is set by Next.js itself ('production' marks the OAuth state cookie Secure); do not set it here.
